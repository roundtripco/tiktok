# توكن البوت من @BotFather
BOT_TOKEN=
# رقمك في تيليجرام (تعرفه من @userinfobot). تقدر تحط أكثر من رقم بينهم فاصلة
ADMIN_IDS=
# اسم الخدمة اللي يشوفه العملاء
SERVICE_NAME=مساعد المكتب العقاري
# اختياري: رابط دفع دائم. إذا فاضي (الوضع الحالي)، المكتب يضغط «اطلب رابط الدفع»
# ويوصلك طلب في البوت، تسوي رابط من UPay وتلصقه، والبوت يرسله للمكتب
UPAY_LINK=
PRICE_KWD=12
TRIAL_DAYS=14
# ساعة إرسال التذكيرات اليومية بتوقيت الكويت
REMINDER_HOUR=9
# رقم أو معرف للدعم يظهر في رسالة التجديد (اختياري)
SUPPORT_CONTACT=
# مكان حفظ قاعدة البيانات والشعارات (اختياري)
# DATA_DIR=/var/lib/aqarbot
# لوحة التحكم: العنوان اللي تفتحه من المتصفح (IP السيرفر + المنفذ). اتركه فاضي لتعطيل اللوحة
DASHBOARD_URL=http://187.127.84.160:8081
DASHBOARD_PORT=8081
